<?xml version="1.0"?>
<robot name="box">

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="1 1 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <link name="top_link">
    <visual>
      <geometry>
        <box size="1 1 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="top_to_bottom" type="fixed">
    <parent link="base_link"/>
    <child link="top_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
</robot>
