<robot name="box">
<material name="box_color">
<color rgba="0.2 0.6 0.3 0.8"/>
</material>
<material name="lid_color">
<color rgba="0.6 0.4 0.2 1.0"/>
</material>
<link name="base_link">
<visual>
<geometry>
<box size="1 1 0.05"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
<material name="box_color"/>
</visual>
</link>
<joint name="right_to_bottom" type="fixed">
<parent link="base_link"/>
<child link="right_link"/>
<origin xyz="0 0.5 0" rpy="0 0 0"/>
</joint>
<link name="right_link">
<visual>
<geometry>
<box size="1 1 0.05"/>
</geometry>
<origin xyz="0 0 0.5" rpy="1.5708 0 0"/>
<material name="box_color"/>
</visual>
</link>
<joint name="left_to_bottom" type="fixed">
<parent link="base_link"/>
<child link="left_link"/>
<origin xyz="0 -0.5 0" rpy="0 0 0"/>
</joint>
<link name="left_link">
<visual>
<geometry>
<box size="1 1 0.05"/>
</geometry>
<origin xyz="0 0 0.5" rpy="1.5708 0 0"/>
<material name="box_color"/>
</visual>
</link>
<joint name="front_to_bottom" type="fixed">
<parent link="base_link"/>
<child link="front_link"/>
<origin xyz="0.5 0 0" rpy="0 0 0"/>
</joint>
<link name="front_link">
<visual>
<geometry>
<box size="1 1 0.05"/>
</geometry>
<origin xyz="0 0 0.5" rpy="0 1.5708 0"/>
<material name="box_color"/>
</visual>
</link>
<joint name="back_to_bottom" type="fixed">
<parent link="base_link"/>
<child link="back_link"/>
<origin xyz="-0.5 0 0" rpy="0 0 0"/>
</joint>
<link name="back_link">
<visual>
<geometry>
<box size="1 1 0.05"/>
</geometry>
<origin xyz="0 0 0.5" rpy="0 1.5708 0"/>
<material name="box_color"/>
</visual>
</link>
<joint name="top_to_back" type="revolute">
<parent link="back_link"/>
<child link="top_link"/>
<origin xyz="0 0 1" rpy="0 0 0"/>
<axis xyz="0 -1 0"/>
<limit effort="1000.0" lower="0.0" upper="1.5708" velocity="0.5"/>
</joint>
<link name="top_link">
<visual>
<geometry>
<box size="1 1 0.05"/>
</geometry>
<origin xyz="0.5 0 0" rpy="0 0 0"/>
<material name="lid_color"/>
</visual>
</link>
</robot>
